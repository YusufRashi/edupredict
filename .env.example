# Copy to .env and replace every value marked CHANGE ME. Never commit .env.

ENVIRONMENT=development

# --- Database ---
POSTGRES_DB=edupredict
POSTGRES_USER=edupredict
POSTGRES_PASSWORD=CHANGE_ME_database_password
# Host port. 5433 avoids clashing with another local PostgreSQL on 5432.
POSTGRES_HOST_PORT=5433

# Only for running the backend outside Docker. Keep the password in step with the one above.
# Use 127.0.0.1, not localhost: the container publishes on IPv4 only.
DATABASE_URL=postgresql+psycopg://edupredict:CHANGE_ME_database_password@127.0.0.1:5433/edupredict

# --- Authentication ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_value
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- First administrator, created once on first start ---
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=CHANGE_ME_admin_password1

# --- Demonstration data ---
# true creates pseudonymous demo students from held-out UCI rows, plus demo logins.
# Leave false in production. DEMO_PASSWORD is required when this is true.
SEED_DEMO_DATA=true
DEMO_PASSWORD=CHANGE_ME_demo_password1

# --- Web ---
API_HOST_PORT=8000
WEB_HOST_PORT=8088
CORS_ORIGINS=http://localhost:5173,http://localhost:8088

# --- Uploads ---
MAX_UPLOAD_BYTES=5242880
MAX_UPLOAD_ROWS=20000
